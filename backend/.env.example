DATABASE_URL=postgresql+psycopg://YOUR_LOCAL_POSTGRES_USER@127.0.0.1:5432/careerlens
JWT_SECRET_KEY=replace-this-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional: keep "rules" until Ollama is installed and a local model is available.
CAREER_ANALYSIS_PROVIDER=rules
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_TIMEOUT_SECONDS=180
